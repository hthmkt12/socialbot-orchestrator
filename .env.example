# Frontend
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_GATEWAY_BASE_URL=http://127.0.0.1:8080
VITE_WORKER_BASE_URL=http://127.0.0.1:4310
VITE_MOBILE_MCP_BRIDGE_URL=http://127.0.0.1:4321
# Pilot-only browser encryption key for social account passwords.
# Use 32+ random characters. This is not a production credential vault:
# production social credentials require a later server-side key-management boundary.
VITE_ACCOUNT_PASSWORD_KEY=**************************************
# Server-side credential encryption key for Supabase Edge Function (credential-vault).
# Must be 32+ characters. Generate with: openssl rand -base64 32
# Set as a Supabase project secret, NOT in client env.
# SERVER_CREDENTIAL_KEY=
# Legacy pilot key for v2: to s3: migration (Phase D). Must match the old
# VITE_ACCOUNT_PASSWORD_KEY value. Set as a Supabase project secret, NOT in
# client env. Required only for the migration endpoint; remove after all v2:
# payloads are migrated.
# LEGACY_PILOT_KEY=
# auto tries the Edge Function first, browser skips it for local projects without deployed functions.
VITE_RUN_CONTROL_MODE=auto

# Backend / control plane
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the elevated backend key here.
# For newer Supabase projects, prefer an sb_secret_... key.
# Legacy service_role JWT keys also work if that is what the project exposes.
# Also used by the credential-vault Edge Function for DB writes during v2:
# to s3: migration (Phase D). Server-only - never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Optional dedicated key accepted by credential-vault worker decrypt. When set,
# the worker sends this key to the vault and keeps SUPABASE_SERVICE_ROLE_KEY for
# its own database/control-plane access. Falls back to SUPABASE_SERVICE_ROLE_KEY.
# CREDENTIAL_BOUNDARY_SERVICE_ROLE_KEY=
# Internal worker token for credential-vault decrypt authorization.
# The execution worker sends this as X-Credential-Vault-Worker-Token alongside
# the service-role bearer. Set as a Supabase project secret AND in the worker
# runtime env. Server-only - never expose to the browser.
# CREDENTIAL_VAULT_WORKER_TOKEN=
GATEWAY_BASE_URL=http://127.0.0.1:8080
# Required by the gateway and execution worker for protected HTTP control routes.
# Server-only; never expose this token through a VITE_ variable.
GATEWAY_HTTP_TOKEN=replace-with-random-gateway-http-token
# Required in device registration messages before a WebSocket session is accepted.
GATEWAY_DEVICE_ENROLLMENT_TOKEN=replace-with-random-device-enrollment-token
# Local-only escape hatch. Production/default startup fails closed without both tokens.
GATEWAY_ALLOW_INSECURE_DEV=false
# Per-client protected HTTP request limit over a one-minute window.
GATEWAY_HTTP_RATE_LIMIT_PER_MINUTE=120
# Exact browser origin allowed to call credential-vault. Worker calls have no Origin.
CREDENTIAL_VAULT_ALLOWED_ORIGIN=http://localhost:5173
DEVICE_BACKEND=laixi
# Set to mobilerun to enable ai_task step type (requires LLM config below)
# MOBILERUN_LLM_PROVIDER=OpenAIResponses
# MOBILERUN_LLM_MODEL=gpt-4o
# MOBILERUN_LLM_API_KEY=sk-...
MOBILE_MCP_BRIDGE_URL=http://127.0.0.1:4321
# Required for credential-boundary remediation Phase 3 runtime proof.
# Set to the Mobile MCP bridge URL with a connected Android device only when
# running the controlled credential-login proof; do not claim full verification
# until every remediation release gate has passed.
# Example: MOBILE_MCP_BRIDGE_URL=http://127.0.0.1:4321 (device 97249fb5)
# Shared secret for bridge auth. Required unless MOBILE_MCP_ALLOW_INSECURE_DEV=true.
MOBILE_MCP_BRIDGE_TOKEN=replace-with-random-local-bridge-token
# Local-only escape hatch. Do not use outside isolated development.
MOBILE_MCP_ALLOW_INSECURE_DEV=false
# Optional: attempt Mobilerun Portal setup when an Android session starts.
# Leave false for ADB-first local smoke devices that block USB installs.
MOBILE_MCP_ENSURE_PORTAL_ON_SESSION=false
# CORS origin for bridge and gateway. Defaults to http://localhost:5173.
BRIDGE_CORS_ORIGIN=http://localhost:5173
GATEWAY_CORS_ORIGIN=http://localhost:5173
MOBILE_MCP_EXPECTED_SERIALS=QC4DKJUO6PW4FMQW,R58MC1XNTLR
# iOS Portal URLs are also supported (comma-separated):
# MOBILE_MCP_EXPECTED_SERIALS=http://127.0.0.1:6643,http://127.0.0.1:6644
DEVICE_COMMAND_TIMEOUT_MS=15000
GATEWAY_PORT=8080
WORKER_PORT=4310
RUN_POLL_INTERVAL_MS=2000
# Runtime-only evidence directories for the controlled credential proof. The
# proof fails closed when either directory is missing or contains the canary.
# CREDENTIAL_BOUNDARY_WORKER_LOG_DIR=logs/credential-proof/worker
# CREDENTIAL_BOUNDARY_BRIDGE_LOG_DIR=logs/credential-proof/bridge
# Required when worker/bridge are already running and the orchestrator does not
# start them. Must point to independently captured log directories.
# CREDENTIAL_BOUNDARY_EXISTING_WORKER_LOG_DIR=
# CREDENTIAL_BOUNDARY_EXISTING_BRIDGE_LOG_DIR=
# Short-lived OPERATOR or ADMIN JWT for the proof encrypt action.
# Generate via Supabase auth or admin API; never commit a real value.
# PROOF_OPERATOR_JWT=
# Disposable password/canary for the proof run. Process env only, never commit.
# CREDENTIAL_BOUNDARY_CANARY=
# Explicit opt-in for destructive remote execution. Must be set to "true"
# alongside the --run-real-proof CLI flag to execute the real proof.
# CREDENTIAL_BOUNDARY_ALLOW_REAL_PROOF=false
RUN_LEASE_TTL_MS=15000
WORKER_MAX_ACTIVE_CLAIMS=5
DEVICE_HEALTH_SYNC_INTERVAL_MS=15000

# Optional UI smoke inputs. Do not commit real passwords.
UI_SMOKE_BASE_URL=http://127.0.0.1:5173
UI_SMOKE_EMAIL=codex-ui-operator@example.invalid
UI_SMOKE_PASSWORD=your-test-user-password
UI_SMOKE_DEVICE_MATCHES=23106RN0DA,SM-A515F
UI_SMOKE_APP_NAME=com.android.settings
