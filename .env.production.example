# Production Docker Compose Environment Template
# Copy to .env.production on deployment server:
# cp .env.production.example .env.production

# -----------------------------------------------------------------------------
# Frontend Service Configuration
# -----------------------------------------------------------------------------
FRONTEND_PORT=80
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-production-anon-key
VITE_ACCOUNT_PASSWORD_KEY=replace-with-strong-random-32-char-key

# -----------------------------------------------------------------------------
# Control Plane & Backend Supabase Connectivity
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-production-service-role-key
CREDENTIAL_VAULT_WORKER_TOKEN=replace-with-random-vault-worker-token

# -----------------------------------------------------------------------------
# Execution Worker Configuration
# -----------------------------------------------------------------------------
DEVICE_BACKEND=mobile-mcp
MOBILE_MCP_BRIDGE_URL=http://host.docker.internal:4321
MOBILE_MCP_BRIDGE_TOKEN=replace-with-random-bridge-token
WORKER_CORS_ORIGIN=http://your-production-domain.com
DEVICE_COMMAND_TIMEOUT_MS=30000
RUN_POLL_INTERVAL_MS=5000
RUN_LEASE_TTL_MS=60000

# -----------------------------------------------------------------------------
# Laixi Gateway Configuration
# -----------------------------------------------------------------------------
GATEWAY_HTTP_TOKEN=replace-with-random-gateway-http-token
GATEWAY_DEVICE_ENROLLMENT_TOKEN=replace-with-random-enrollment-token
GATEWAY_CORS_ORIGIN=http://your-production-domain.com
